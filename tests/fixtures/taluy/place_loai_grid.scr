CMDECHO 0
OSMODE 0
ATTREQ 0
(princ "
TALUY_ROW_BEGIN")
(progn (setq er 0)
(foreach bn '("BLOCK GIA CO" "LOAI 1" "LOAI 2" "LOAI 3" "ke" "TALUY-ROW1")
(setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 bn))))
(if ss (repeat (sslength ss) (entdel (ssname ss 0)) (setq er (1+ er)) (setq ss (ssdel (ssname ss 0) ss)))))
(princ (strcat "
TALUY_ERASED=" (itoa er))))
