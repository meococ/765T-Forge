    (setq ss (ssget "_X" (list (cons 0 "INSERT") (cons 2 bn))))
    (if ss (progn (setq i 0 n (sslength ss)) (while (< i n) (entdel (ssname ss i)) (setq er (1+ er) i (1+ i)))))
  )
