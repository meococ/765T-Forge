(progn
  (princ "\nTALUY_ROW_BEGIN")
  (setq er 0)
  (setq ss (ssget "_X" '((0 . "INSERT"))))
  (if ss
    (progn
      (setq i 0 n (sslength ss))
      (while (< i n)
        (setq e (ssname ss i))
        (setq nm (cdr (assoc 2 (entget e))))
        (if (wcmatch nm "BLOCK GIA CO,LOAI*,ke,TALUY-ROW1")
          (progn
            (entdel e)
            (setq er (1+ er))
          )
        )
        (setq i (1+ i))
      )
    )
  )
  (princ (strcat "\nTALUY_ERASED=" (itoa er)))
  (command "_.-LAYER" "_M" "TALUY-GIACO" "_C" "2" "TALUY-GIACO" "")
  (setq placed 0)
)
