# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,sln,slnf}]
indent_size = 2

[*.{json,yml,yaml,md}]
indent_size = 2

[*.ps1]
indent_size = 4
end_of_line = crlf

[*.{cmd,bat}]
end_of_line = crlf
