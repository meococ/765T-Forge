<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <Version>0.2.1</Version>
    <Authors>765T</Authors>
    <Company>765T</Company>
    <Product>765T-Forge</Product>
    <Description>AutoCAD 2026 MCP server for metro/AEC drawing production workflows.</Description>
    <Copyright>Copyright (c) 2026 765T</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/765T/765T-Forge</RepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
