<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AutoCadRoot Condition="'$(AUTOCAD_2026_ROOT)' != ''">$(AUTOCAD_2026_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AutoCadRoot>
    <!-- docs/cad-job-tools.md C2: the year this build targets, stamped as assembly
         metadata; build-plugin.ps1 -Year feeds it. The plugin refuses dispatch on a
         host of another year (HostYearPolicy) until that pair is proven. -->
    <ForgeTargetYear Condition="'$(ForgeTargetYear)' == ''">2026</ForgeTargetYear>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="ForgeTargetYear" Value="$(ForgeTargetYear)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forge.Shared\Forge.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" />
    <PackageReference Include="System.IO.Pipes.AccessControl" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCadRoot)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCadRoot)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCadRoot)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
