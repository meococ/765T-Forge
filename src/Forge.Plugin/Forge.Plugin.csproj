<Project Sdk="Microsoft.NET.Sdk">
  <!--
    One output per AutoCAD year. The year table must match Forge.Shared/AutoCadHostCatalog
    and plugin-bundle/765T-Forge.bundle/PackageContents.xml.
    Default year is 2026 so existing 2026 builds and CI stay valid.
    CLR from Autodesk managed-compatibility tables: 2017–2018 net46 (.NET Framework 4.6),
    2019–2020 net47, 2021–2024 net48, 2025–2026 net8.0-windows.
    2017–2018 stay on net46. System.Text.Json 8.0.5 cannot restore for net46 (NU1202), so Forge.Shared
    uses Newtonsoft.Json on that TFM only. net461 is not used: it is newer than the documented CLR,
    and System.Text.Json 8 warns that net461 is unsupported.
  -->
  <PropertyGroup>
    <AutoCadYear Condition="'$(AutoCadYear)' == ''">2026</AutoCadYear>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <DefineConstants>$(DefineConstants);ACAD_YEAR_$(AutoCadYear)</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\autocad-$(AutoCadYear)\</OutputPath>
    <IntermediateOutputPath>obj\autocad-$(AutoCadYear)\</IntermediateOutputPath>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2017'">net46</AutoCadTargetFramework>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2018'">net46</AutoCadTargetFramework>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2019'">net47</AutoCadTargetFramework>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2020'">net47</AutoCadTargetFramework>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2021'">net48</AutoCadTargetFramework>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2022'">net48</AutoCadTargetFramework>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2023'">net48</AutoCadTargetFramework>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2024'">net48</AutoCadTargetFramework>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2025'">net8.0-windows</AutoCadTargetFramework>
    <AutoCadTargetFramework Condition="'$(AutoCadYear)' == '2026'">net8.0-windows</AutoCadTargetFramework>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2017'">R21.0</ExpectedSeries>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2018'">R22.0</ExpectedSeries>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2019'">R23.0</ExpectedSeries>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2020'">R23.1</ExpectedSeries>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2021'">R24.0</ExpectedSeries>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2022'">R24.1</ExpectedSeries>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2023'">R24.2</ExpectedSeries>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2024'">R24.3</ExpectedSeries>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2025'">R25.0</ExpectedSeries>
    <ExpectedSeries Condition="'$(AutoCadYear)' == '2026'">R25.1</ExpectedSeries>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2017'">21</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2017'">0</ExpectedAcadMinor>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2018'">22</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2018'">0</ExpectedAcadMinor>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2019'">23</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2019'">0</ExpectedAcadMinor>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2020'">23</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2020'">1</ExpectedAcadMinor>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2021'">24</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2021'">0</ExpectedAcadMinor>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2022'">24</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2022'">1</ExpectedAcadMinor>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2023'">24</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2023'">2</ExpectedAcadMinor>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2024'">24</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2024'">3</ExpectedAcadMinor>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2025'">25</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2025'">0</ExpectedAcadMinor>
    <ExpectedAcadMajor Condition="'$(AutoCadYear)' == '2026'">25</ExpectedAcadMajor>
    <ExpectedAcadMinor Condition="'$(AutoCadYear)' == '2026'">1</ExpectedAcadMinor>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2017' and '$(AUTOCAD_2017_ROOT)' != ''">$(AUTOCAD_2017_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2018' and '$(AUTOCAD_2018_ROOT)' != ''">$(AUTOCAD_2018_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2019' and '$(AUTOCAD_2019_ROOT)' != ''">$(AUTOCAD_2019_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2020' and '$(AUTOCAD_2020_ROOT)' != ''">$(AUTOCAD_2020_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2021' and '$(AUTOCAD_2021_ROOT)' != ''">$(AUTOCAD_2021_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2022' and '$(AUTOCAD_2022_ROOT)' != ''">$(AUTOCAD_2022_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2023' and '$(AUTOCAD_2023_ROOT)' != ''">$(AUTOCAD_2023_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2024' and '$(AUTOCAD_2024_ROOT)' != ''">$(AUTOCAD_2024_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2025' and '$(AUTOCAD_2025_ROOT)' != ''">$(AUTOCAD_2025_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == '' and '$(AutoCadYear)' == '2026' and '$(AUTOCAD_2026_ROOT)' != ''">$(AUTOCAD_2026_ROOT)</AutoCadRoot>
    <AutoCadRoot Condition="'$(AutoCadRoot)' == ''">C:\Program Files\Autodesk\AutoCAD $(AutoCadYear)</AutoCadRoot>
  </PropertyGroup>

  <!-- Normal builds target one AutoCadYear. Pass ForgeRestorePluginFrameworks=true only to
       restore every TFM into packages.lock.json; do not commit that rewrite unless every TFM is still present. -->
  <PropertyGroup Condition="'$(ForgeRestorePluginFrameworks)' == 'true'">
    <TargetFrameworks>net8.0-windows;net48;net47;net46</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ForgeRestorePluginFrameworks)' != 'true'">
    <TargetFramework>$(AutoCadTargetFramework)</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants Condition="'$(TargetFramework)' == 'net46'">$(DefineConstants);FORGE_NET46</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forge.Shared\Forge.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Roslyn scripting is netstandard2.0. net46 (AutoCAD 2017–2018) cannot reference it. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Condition="'$(TargetFramework)' != 'net46'" />
    <PackageReference Include="System.IO.Pipes.AccessControl" Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' != 'net46'" />
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>$(AutoCadRoot)\AcCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>$(AutoCadRoot)\AcDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>$(AutoCadRoot)\AcMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- A non-2026 restore rewrites packages.lock.json to that year's TFM. Put the 2026 lock file back
       so the committed net8.0-windows graph (and its RIDs) is not dropped. -->
  <Target Name="SnapshotPluginLockFile" BeforeTargets="Restore" Condition="'$(AutoCadYear)' != '2026' and '$(ForgeRestorePluginFrameworks)' != 'true' and Exists('$(MSBuildProjectDirectory)\packages.lock.json')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\packages.lock.json" DestinationFiles="$(MSBuildProjectDirectory)\obj\packages.lock.json.keep" />
  </Target>
  <Target Name="RestorePluginLockFile" AfterTargets="Restore" Condition="'$(AutoCadYear)' != '2026' and '$(ForgeRestorePluginFrameworks)' != 'true' and Exists('$(MSBuildProjectDirectory)\obj\packages.lock.json.keep')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\obj\packages.lock.json.keep" DestinationFiles="$(MSBuildProjectDirectory)\packages.lock.json" />
    <Delete Files="$(MSBuildProjectDirectory)\obj\packages.lock.json.keep" />
  </Target>

  <Target Name="RequireMatchingAutoCadReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(ForgeRestorePluginFrameworks)' != 'true'">
    <Error Condition="'$(AutoCadTargetFramework)' == '' and '$(ForgeRestorePluginFrameworks)' != 'true'"
           Text="AutoCadYear=$(AutoCadYear) is not a Forge host. Use a year from 2017 through 2026." />
    <Error Condition="!Exists('$(AutoCadRoot)\AcCoreMgd.dll')"
           Text="AutoCAD $(AutoCadYear) reference assembly AcCoreMgd.dll was not found at '$(AutoCadRoot)\AcCoreMgd.dll'. Set AUTOCAD_$(AutoCadYear)_ROOT to the AutoCAD $(AutoCadYear) install folder (the directory that contains AcCoreMgd.dll, AcDbMgd.dll, and AcMgd.dll). Forge will not compile this year against a different year's assemblies." />
    <Error Condition="!Exists('$(AutoCadRoot)\AcDbMgd.dll')"
           Text="AutoCAD $(AutoCadYear) reference assembly AcDbMgd.dll was not found at '$(AutoCadRoot)\AcDbMgd.dll'. Set AUTOCAD_$(AutoCadYear)_ROOT to the AutoCAD $(AutoCadYear) install folder. Forge will not compile this year against a different year's assemblies." />
    <Error Condition="!Exists('$(AutoCadRoot)\AcMgd.dll')"
           Text="AutoCAD $(AutoCadYear) reference assembly AcMgd.dll was not found at '$(AutoCadRoot)\AcMgd.dll'. Set AUTOCAD_$(AutoCadYear)_ROOT to the AutoCAD $(AutoCadYear) install folder. Forge will not compile this year against a different year's assemblies." />
    <PropertyGroup Condition="Exists('$(AutoCadRoot)\AcCoreMgd.dll')">
      <_AcadFileMajor>$([System.Diagnostics.FileVersionInfo]::GetVersionInfo('$(AutoCadRoot)\AcCoreMgd.dll').FileMajorPart)</_AcadFileMajor>
      <_AcadFileMinor>$([System.Diagnostics.FileVersionInfo]::GetVersionInfo('$(AutoCadRoot)\AcCoreMgd.dll').FileMinorPart)</_AcadFileMinor>
      <_AcadProductMajor>$([System.Diagnostics.FileVersionInfo]::GetVersionInfo('$(AutoCadRoot)\AcCoreMgd.dll').ProductMajorPart)</_AcadProductMajor>
      <_AcadProductMinor>$([System.Diagnostics.FileVersionInfo]::GetVersionInfo('$(AutoCadRoot)\AcCoreMgd.dll').ProductMinorPart)</_AcadProductMinor>
    </PropertyGroup>
    <Error Condition="Exists('$(AutoCadRoot)\AcCoreMgd.dll') and ('$(_AcadFileMajor)' != '$(ExpectedAcadMajor)' or '$(_AcadFileMinor)' != '$(ExpectedAcadMinor)') and ('$(_AcadProductMajor)' != '$(ExpectedAcadMajor)' or '$(_AcadProductMinor)' != '$(ExpectedAcadMinor)')"
           Text="AutoCAD reference at '$(AutoCadRoot)' reports file version $(_AcadFileMajor).$(_AcadFileMinor) and product version $(_AcadProductMajor).$(_AcadProductMinor), but AutoCadYear=$(AutoCadYear) requires $(ExpectedAcadMajor).$(ExpectedAcadMinor) ($(ExpectedSeries)). Refusing to compile against a different year." />
  </Target>
</Project>
