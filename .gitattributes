# Normalize text; keep Windows scripts CRLF.
* text=auto eol=lf

*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
*.dwg binary
*.dxf binary
*.dll binary
*.exe binary
*.zip binary
